# Virtual environment
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Downloaded and cached data.
# These are large, they are regenerated by running the pipeline, and they are
# copies of somebody else's data. They do not belong in git.
data/raw/
data/cache/
data/interim/

# data/processed/ and outputs/ are deliberately NOT ignored.
# The deployed dashboard reads them at runtime, and Streamlit Community Cloud
# only has what is in the repository. It cannot run the pipeline.
# data/manual/ is also tracked, because hand entered start times cannot be
# regenerated by anything.

# Local run logs
*.log
scrape_run.log

# Jupyter
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
